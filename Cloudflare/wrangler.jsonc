{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "uw-social-ai",
  "main": "src/index.mjs",
  "compatibility_date": "2026-10-16",
  "workers_dev": true,
  "ai": { "binding": "AI", "remote": true },
  "vars": {
    "FIREBASE_PROJECT_ID": "uw-social-ae4c7",
    "ALLOWED_ORIGINS": "https://uw-social.com,https://www.uw-social.com,https://uw-social.github.io,http://localhost:5173"
  },
  "ratelimits": [
    { "name": "USER_RATE_LIMITER", "namespace_id": "817001", "simple": { "limit": 5, "period": 60 } },
    { "name": "APP_RATE_LIMITER", "namespace_id": "817002", "simple": { "limit": 30, "period": 60 } }
  ]
}
